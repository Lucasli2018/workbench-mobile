/* 首页专属样式 */
.greet-title { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; }
.greet-sub { font-size: 13px; color: #4a5e83; margin-top: 6px; }
.hero-avatar { position: absolute; right: 16px; top: 16px; width: 48px; height: 48px; border-radius: 50%; border: 2px solid rgba(255,255,255,.6); box-shadow: 0 4px 12px rgba(37,99,235,.15); }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; }
.qbtn { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 18px 8px 14px; border: none; border-radius: 16px; background: #fff; border: 1px solid #cdd9f0; box-shadow: 0 2px 8px rgba(19,33,62,.04); text-align: center; transition: transform .12s, border-color .15s; }
.qbtn:active { transform: scale(.96); border-color: #aebfe2; }
.qbtn-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; }
.qbtn-label { font-size: 12px; font-weight: 600; color: #13213e; }
.ring-wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 18px 6px; }
.ring-item { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.ring-circle { width: 60px; height: 60px; position: relative; }
.ring-label { font-size: 11px; color: #4a5e83; font-weight: 600; }
.ring-sub { font-size: 10.5px; color: #7e90b3; }
.section-title { display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 700; margin: 28px 0 14px; letter-spacing: -0.01em; }
.section-title::before { content: ""; width: 3px; height: 14px; border-radius: 2px; background: #2563eb; }
.card { background: #fff; border-radius: 20px; border: 1px solid #cdd9f0; box-shadow: 0 4px 20px rgba(37,99,235,.08); overflow: hidden; }
.pin-list { display: flex; flex-direction: column; gap: 10px; }
.pin-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: #fff; border: 1px solid #cdd9f0; border-radius: 14px; box-shadow: 0 2px 8px rgba(19,33,62,.04); }
.pin-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: 0 0 auto; background: #f0f6ff; border: 1px solid #cdd9f0; }
.pin-body { flex: 1; min-width: 0; }
.pin-title { font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pin-meta { font-size: 11.5px; color: #7e90b3; margin-top: 3px; }
.pin-check { width: 24px; height: 24px; border-radius: 7px; border: 1.8px solid #aebfe2; display: grid; place-items: center; flex: 0 0 auto; background: #fff; color: #fff; transition: all .15s; }
.pin-check.on { background: #10b981; border-color: #10b981; }
