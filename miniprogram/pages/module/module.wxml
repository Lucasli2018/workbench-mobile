<view class="container">
  <view class="hero">
    <view>🐕 {{type}}</view>
    <view style="font-size:22px;font-weight:800;">{{title}}</view>
    <view>{{desc}}</view>
  </view>
  <view class="section-title">记录列表</view>
  <view wx:if="{{items.length > 0}}">
    <view class="card" wx:for="{{items}}" wx:key="id" style="padding:16px;margin-bottom:10px;">
      <view>{{item.title || "无标题"}}</view>
      <view>{{item.note || "-"}}</view>
    </view>
  </view>
  <view wx:else>暂无记录</view>
  <button bindtap="addItem">+ 新建</button>
</view>
