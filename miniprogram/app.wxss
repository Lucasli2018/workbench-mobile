/* 清新高级风格 — 蓝色科技底纹 + 卡通小狗元素 */
page {
  background: linear-gradient(180deg, #eaf2ff 0%, #e7efff 40%, #e4ecff 100%);
  color: #13213e;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.55;
}
.container {
  padding: 0 18px 30px;
}
.card {
  background: #fff;
  border-radius: 20px;
  border: 1px solid #cdd9f0;
  box-shadow: 0 4px 20px rgba(37,99,235,.08);
  overflow: hidden;
}
.section-title {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 15px;
  font-weight: 700;
  margin: 28px 0 14px;
  letter-spacing: -0.01em;
}
.section-title::before { content: ""; width: 3px; height: 14px; border-radius: 2px; background: #2563eb; }
.hero {
  position: relative; border-radius: 20px; overflow: hidden; padding: 26px 22px 28px; margin-top: 10px;
  background: linear-gradient(110deg, rgba(240,246,255,.9) 25%, rgba(240,246,255,.5) 55%, rgba(240,246,255,.2) 75%);
  border: 1px solid #cdd9f0; box-shadow: 0 6px 24px rgba(37,99,235,.10);
}
.hero-text h1 { font-size: 24px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; }
.hero-text p { color: #4a5e83; font-size: 13px; margin-top: 6px; }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; }
.qbtn {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  padding: 18px 8px 14px; border: none; border-radius: 16px;
  background: #fff; border: 1px solid #cdd9f0;
  box-shadow: 0 2px 8px rgba(19,33,62,.04); text-align: center;
  transition: transform .12s, border-color .15s;
}
.qbtn:active { transform: scale(.96); border-color: #aebfe2; }
.qbtn-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; }
.qbtn-label { font-size: 12px; font-weight: 600; color: #13213e; }
.ring-wrap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 18px 6px; }
.ring-item { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.ring-circle { width: 60px; height: 60px; }
.ring-pct { font-size: 15px; font-weight: 700; letter-spacing: -0.02em; }
.ring-label { font-size: 11px; color: #4a5e83; font-weight: 600; }
.ring-sub { font-size: 10.5px; color: #7e90b3; }
.pin-list { display: flex; flex-direction: column; gap: 10px; }
.pin-card {
  display: flex; align-items: center; gap: 12px; padding: 14px 16px;
  background: #fff; border: 1px solid #cdd9f0; border-radius: 14px; box-shadow: 0 2px 8px rgba(19,33,62,.04);
}
.pin-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex: 0 0 auto; background: #f0f6ff; border: 1px solid #cdd9f0; }
.pin-body { flex: 1; min-width: 0; }
.pin-title { font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pin-meta { font-size: 11.5px; color: #7e90b3; margin-top: 3px; }
.pin-check { width: 24px; height: 24px; border-radius: 7px; border: 1.8px solid #aebfe2; display: grid; place-items: center; flex: 0 0 auto; background: #fff; color: #fff; transition: all .15s; }
.pin-check.on { background: #10b981; border-color: #10b981; }
.quote-block { padding: 16px 18px; border-radius: 16px; background: #fff; border: 1px solid #cdd9f0; box-shadow: 0 2px 8px rgba(19,33,62,.04); position: relative; margin-top: 14px; }
.quote-block::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 2px; background: #2563eb; }
.quote-tag { font-size: 11px; font-weight: 700; color: #7e90b3; letter-spacing: .04em; margin-bottom: 8px; }
.quote-text { font-size: 15.5px; font-weight: 600; line-height: 1.55; color: #13213e; }
.empty-state { padding: 48px 20px; text-align: center; }
.empty-state .e-icon { width: 56px; height: 56px; border-radius: 16px; background: #fff; border: 1px solid #cdd9f0; display: inline-grid; place-items: center; margin-bottom: 14px; color: #7e90b3; }
.empty-state .e-text { font-size: 14px; color: #7e90b3; line-height: 1.7; }
.modal-mask { position: fixed; inset: 0; background: rgba(19,33,62,.42); z-index: 100; display: flex; align-items: flex-end; justify-content: center; animation: fadeIn .2s ease; }
.modal-card { width: 100%; max-width: 480px; background: #fff; border-radius: 24px 24px 0 0; padding: 24px 20px 32px; animation: slideUp .28s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
